{
  "all": true,
  "include": ["src/**/*.js"],
  "exclude": [
    "src/ui/**",
    "src/*Screen.js",
    "src/*Panel.js",
    "src/*Modal.js",
    "src/*Form.js",
    "src/*View.js",
    "src/*Editor.js",
    "src/Chapter*.js",
    "src/AssistantMessageBody.js",
    "src/RichHtmlMessage.js",
    "src/ScrollScrubber.js",
    "src/assistantRender.js",
    "src/disclaimer.js",
    "src/proactiveMessage.js",
    "src/stickerImages.js",
    "src/theme/ThemeContext.js",
    "src/theme/tokens.js",
    "src/context/AppContext.js",
    "src/chat/MessageBubble.js",
    "src/chat/ErrorBubble.js",
    "src/chat/ThinkingIndicator.js",
    "src/chat/SelectionTextModal.js",
    "src/chat/SwitcherModal.js",
    "src/chat/MentionPickerModal.js",
    "src/chat/ModelPanelModal.js",
    "src/chat/ThinkingPanelModal.js",
    "src/chat/StickerPanelModal.js",
    "src/chat/StickerNamePromptModal.js",
    "src/chat/useScrollScrubber.js",
    "src/chat/useChatSearch.js",
    "src/chat/useChatTts.js",
    "src/chat/useChatModelThinking.js",
    "src/chat/chatStyles.js"
