{
  "expo": {
    "name": "EasyChat2",
    "scheme": "easychat2",
    "slug": "easychat2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#118afd"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "newArchEnabled": true,
    "plugins": [
      [
        "./plugins/withAsyncStorageDbSize",
        {
          "sizeMB": 1024
        }
      ],
      "./plugins/withProactiveMessage",
      "./plugins/withLocalApiServer",
      "./plugins/withShellExecutor",
      "./plugins/withScreenOverlay",
      [
        "expo-image-picker",
        {
          "photosPermission": "选择图片发送到聊天或保存为表情包",
          "cameraPermission": "拍摄照片发送到聊天"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "x86_64"
            ]
          }
        }
      ],
      [
        "llama.rn",
        {
          "enableOpenCLAndHexagon": false,
          "forceCxx20": true
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": true,
          "microphonePermission": "录制语音消息需要访问麦克风"
        }
      ]
    ],
    "android": {
      "package": "com.pppxxxy.easychat2",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#118afd"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "选择图片发送到聊天或保存为表情包",
        "NSCameraUsageDescription": "拍摄照片发送到聊天"
      }
    },
    "extra": {
      "eas": {
        "projectId": "fee286ec-f845-4436-a5a2-3b9ade3a5d4c"
      }
    }
  }
}
