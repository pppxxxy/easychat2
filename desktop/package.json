{
  "name": "easychat2-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "EasyChat2 Windows desktop shell (Electron + React DOM), sharing src/ business logic through platform aliases",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist": "vite build && electron-builder --win nsis zip --publish never",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "smoke": "vite build && node scripts/smoke.mjs",
    "smoke:kilo": "vite build && node scripts/smoke-kilo.mjs",
    "test:coverage": "c8 --check-coverage --lines 60 --reporter=text --include=src/render/*.js --include=src/chat/usageView.js --include=src/chat/branchNav.js --include=src/character/libraryView.js --include=src/memory/memoryListView.js --include=src/group/groupModel.js --include=src/chat/greetingView.js --include=src/chat/greetingRequest.js --include=src/attachments/mediaFile.js --include=src/stickers/stickerImage.js --include=src/platform/fileSystem.js --include=src/platform/fileNext.js --include=src/platform/asyncStorage.js --include=src/platform/mediaUrl.js --include=src/platform/xhr.js --include=src/platform/secureStore.js --include=src/platform/bridge.js --include=electron/paths.js --include=electron/ipc/kv.js --include=electron/ipc/fs.js --include=electron/ipc/secret.js --include=electron/ipc/http.js --include=electron/ipc/media.js --include=electron/ipc/mediaPick.js --include=electron/ipc/backupFiles.js node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {},
  "devDependencies": {
    "buffer": "^6.0.3",
    "marked": "^15.0.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "c8": "^12.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.easychat2.desktop",
    "productName": "EasyChat2",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!node_modules/**",
      "!build/**"
    ],
    "asar": true,
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "extraResources": [
      {
        "from": "../assets",
        "to": "assets",
        "filter": [
          "easychat-assistant-*.jpg"
        ]
      }
    ]
  },
  "author": {
    "name": "EasyChat2"
  }
}
